{
  "enabledMcpjsonServers": ["n8n-mcp"],
  "permissions": {
    "allow": [
      "mcp__n8n-mcp__tools_documentation",
      "mcp__n8n-mcp__n8n_health_check",
      "mcp__n8n-mcp__n8n_list_workflows",
      "mcp__n8n-mcp__n8n_get_workflow",
      "mcp__n8n-mcp__search_nodes",
      "mcp__n8n-mcp__get_node",
      "mcp__n8n-mcp__search_templates",
      "mcp__n8n-mcp__n8n_create_workflow",
      "mcp__n8n-mcp__n8n_update_partial_workflow",
      "mcp__n8n-mcp__n8n_validate_workflow",
      "mcp__n8n-mcp__n8n_autofix_workflow",
      "mcp__n8n-mcp__n8n_test_workflow",
      "mcp__n8n-mcp__n8n_deploy_template",
      "WebFetch(domain:buildbar.at)",
      "Bash(npx -y n8n-mcp:*)",
      "Bash(npx --version)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:*)",
      "Bash(node --version)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(git clone:*)",
      "Bash(git status:*)",
      "Bash(git check-ignore:*)",
      "Bash(winget install --id GitHub.cli:*)",
      "Bash(winget install --silent --accept-package-agreements --accept-source-agreements OpenJS.NodeJS.LTS)",
      "Bash(brew install node gh)",
      "Bash(brew install gh)",
      "Bash(curl -s -X POST https://deploy-oew.buildbar.at/prepare:*)",
      "Bash(curl -s -X POST https://deploy-oew.buildbar.at/publish:*)",
      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git remote:*)",
      "Bash(git push)",
      "Bash(git config user.name:*)",
      "Bash(git config user.email:*)",
      "Bash(gh auth:*)",
      "Bash(gh repo create ai-automation-bootcamp --private:*)"
    ],
    "ask": [
      "mcp__n8n-mcp__n8n_manage_datatable",
      "mcp__n8n-mcp__n8n_executions",
      "mcp__n8n-mcp__n8n_delete_workflow",
      "Bash(gh api:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__n8n-mcp__n8n_create_workflow|mcp__n8n-mcp__n8n_update_partial_workflow|mcp__n8n-mcp__n8n_update_full_workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-backup.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
